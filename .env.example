# Required
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional: limit command registration to one guild during rollout
DISCORD_GUILD_ID=

# AI: Gemini first, Groq fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=

# SQLite
DATABASE_PATH=./data/nethrion.sqlite
LEGACY_DATA_PATH=./legacy/data.json

# NETHRION defaults; configure through environment only as safe defaults
DEFAULT_JAVA_HOST=nethrionsmp.pixelforge.gg
DEFAULT_JAVA_PORT=25565
DEFAULT_BEDROCK_HOST=15.235.165.81
DEFAULT_BEDROCK_PORT=26091

# Minecraft status provider
MC_STATUS_PROVIDER_URL=https://api.mcsrvstat.us/3
MC_STATUS_TIMEOUT_MS=6000

# Operational
LOG_LEVEL=info
TIMEZONE=Asia/Karachi
PUBLIC_AI_ENABLED=true
AI_REQUIRE_MENTION=true
AI_PUBLIC_CHANNELS=
AI_GLOBAL_DAILY_LIMIT=200
AI_GUILD_DAILY_LIMIT=100
AI_USER_DAILY_LIMIT=20
ACTION_CONFIRM_TTL_SECONDS=120
HISTORY_SEARCH_MAX_MESSAGES=500

# Feature flags
FEATURE_NATURAL_ACTIONS=true
FEATURE_MODERATION=true
FEATURE_ANTI_RAID=true
FEATURE_TICKETS=true
FEATURE_SUGGESTIONS=true
FEATURE_ANALYTICS=true
FEATURE_BACKUPS=true
FEATURE_YOUTUBE=false
FEATURE_IMAGE=false
FEATURE_DASHBOARD=true

# Optional dashboard
DASHBOARD_PORT=8787
DASHBOARD_HOST=127.0.0.1
# Required when dashboard host is not loopback
DASHBOARD_TOKEN=

# Backup
BACKUP_DIR=./backups
BACKUP_RETENTION=10
