DISCORD_TOKEN=your_discord_token
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_STRONG_MODEL=openai/gpt-oss-120b

# Optional image generation
OPENAI_API_KEY=your_openai_api_key
IMAGE_MODEL=gpt-image-2

# DiscordSRV -> Spark account-link bridge
DISCORDSRV_LINK_EVENT_CHANNEL_ID=
DISCORDSRV_BOT_ID=

# DiscordSRV live lookup for `sp profile`.
# Spark sends the lookup command through DiscordSRV's Discord console channel,
# and alerts.yml returns SPARK_LOOKUP into the link-event channel.
DISCORDSRV_CONSOLE_CHANNEL_ID=
DISCORDSRV_CONSOLE_PREFIX=!c
DISCORDSRV_LINK_EVENT_CHANNEL_ID=
DISCORDSRV_BOT_ID=
