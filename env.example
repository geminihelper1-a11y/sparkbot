DISCORD_TOKEN=your_discord_token
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_STRONG_MODEL=openai/gpt-oss-120b

# Optional image generation
OPENAI_API_KEY=your_openai_api_key
IMAGE_MODEL=gpt-image-2

# DiscordSRV -> Spark account-link bridge
DISCORDSRV_LINK_EVENT_CHANNEL_ID=
DISCORDSRV_BOT_ID=

# Live lookup for `sp profile`: RCON is used to run `discordsrv linked <DiscordID>`.
# The DiscordSRV alerts.yml lookup alert then returns SPARK_LOOKUP into the link channel.
DISCORDSRV_RCON_HOST=
DISCORDSRV_RCON_PORT=25575
DISCORDSRV_RCON_PASSWORD=
